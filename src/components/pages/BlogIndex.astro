---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Badge } from '../ui/badge';
import { cardVariants } from '../ui/card';
import { ArrowRightIcon } from '../icons';
import { localePath, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10);
}

function slug(id: string) {
  return id.replace(/^[a-z]+\//, '');
}
---

<Base
  title="blog"
  lang={lang}
  description={lang === 'zh'
    ? 'taimatsu 的开发日志 —— 构建笔记、发布记录与碎碎念。'
    : 'taimatsu build log —— notes, releases and rants.'}
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <h1 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">{t('blog.title')}</h1>
    <p class="mt-4 text-base leading-relaxed text-muted-foreground">{t('blog.subtitle')}</p>

    <div class="mt-12 flex flex-col gap-4">
      {posts.length === 0 && (
        <div class="rounded-xl p-8 text-center text-ui text-muted-foreground shadow-[inset_0_0_0_1px_var(--border)]">{t('blog.empty')}</div>
      )}
      {posts.map((post) => (
        <a href={localePath(lang, `/blog/${slug(post.id)}`)} class={cardVariants({ interactive: true, className: 'px-5' })}>
          <div class="flex flex-wrap items-center gap-2 text-ui-sm text-muted-foreground">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {post.data.tags.map((tag) => <Badge variant="outline" size="sm">{tag}</Badge>)}
          </div>
          <h2 class="font-heading text-lg font-semibold">{post.data.title}</h2>
          <p class="text-ui leading-relaxed text-muted-foreground">{post.data.description}</p>
          <span class="inline-flex items-center gap-1 text-ui font-medium text-primary">
            {t('blog.readMore')} <ArrowRightIcon size={14} className="rtl:-scale-x-100" />
          </span>
        </a>
      ))}
    </div>
  </section>
</Base>

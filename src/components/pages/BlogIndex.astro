---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { localePath, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10);
}

function slug(id: string) {
  return id.replace(/^[a-z]+\//, '');
}
---

<Base
  title="blog"
  lang={lang}
  description={lang === 'zh'
    ? 'taimatsu 的开发日志 —— 构建笔记、发布记录与碎碎念。'
    : 'taimatsu build log —— notes, releases and rants.'}
>
  <section class="relative overflow-hidden">
    <div class="grid-bg absolute inset-0"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
      <div class="text-xs text-muted"><span class="text-phosphor">~</span>/blog</div>
      <h1 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">
        <span class="text-phosphor">#</span> {t('blog.title')}
      </h1>
      <p class="mt-4 text-sm text-muted">{t('blog.subtitle')}</p>

      <div class="mt-12 space-y-4">
        {
          posts.length === 0 && (
            <div class="rounded-lg border border-dashed border-line-bright p-8 text-center text-sm text-muted">
              <span class="text-phosphor">$</span> {t('blog.empty')}
            </div>
          )
        }
        {
          posts.map((post, i) => (
            <a
              href={localePath(lang, `/blog/${slug(post.id)}`)}
              class="card-hover group block rounded-lg border border-line bg-panel p-5"
            >
              <div class="flex items-center gap-3 text-xs text-dim">
                <span>[{String(posts.length - i).padStart(3, '0')}]</span>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                {post.data.tags.map((tag) => (
                  <span class="rounded border border-line px-1.5 py-0.5 text-[10px] text-muted">#{tag}</span>
                ))}
              </div>
              <h2 class="mt-2 font-display text-lg font-bold text-white transition-colors group-hover:text-phosphor">
                {post.data.title}
              </h2>
              <p class="mt-2 text-sm leading-6 text-muted">{post.data.description}</p>
              <div class="mt-3 text-xs text-phosphor-dim">{t('blog.readMore')}</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

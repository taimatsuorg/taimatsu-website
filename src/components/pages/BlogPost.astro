---
import Base from '../../layouts/Base.astro';
import { render, type CollectionEntry } from 'astro:content';
import { Badge } from '../ui/badge';
import { buttonVariants } from '../ui/button';
import { Separator } from '../ui/separator';
import { ArrowLeftIcon } from '../icons';
import { localePath, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10);
}
---

<Base title={post.data.title} description={post.data.description} lang={lang}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <a href={localePath(lang, '/blog')} class={buttonVariants({ variant: 'ghost', size: 'sm', className: '-ms-2.5 text-muted-foreground' })}>
      <ArrowLeftIcon size={14} className="rtl:-scale-x-100" /> {t('blog.back')}
    </a>

    <header class="mt-8">
      <div class="flex flex-wrap items-center gap-2 text-ui-sm text-muted-foreground">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.tags.map((tag) => <Badge variant="outline" size="sm">{tag}</Badge>)}
      </div>
      <h1 class="mt-4 font-heading text-3xl font-semibold leading-tight tracking-tight text-balance sm:text-4xl">{post.data.title}</h1>
      <p class="mt-3 text-base text-muted-foreground">{post.data.description}</p>
    </header>

    <Separator className="my-8" />

    <div class="typeset typeset-reading">
      <Content />
    </div>

    <Separator className="my-12" />
    <p class="text-ui text-muted-foreground">
      {t('blog.eof')} <a href={localePath(lang, '/blog')} class="font-medium text-primary hover:underline">{t('nav.blog')}</a>
    </p>
  </article>
</Base>

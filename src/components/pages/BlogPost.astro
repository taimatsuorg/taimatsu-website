---
import Base from '../../layouts/Base.astro';
import { render, type CollectionEntry } from 'astro:content';
import { localePath, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10);
}
---

<Base title={post.data.title} description={post.data.description} lang={lang}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <a href={localePath(lang, '/blog')} class="text-xs text-muted transition-colors hover:text-phosphor">{t('blog.back')}</a>

    <header class="mt-8 border-b border-line pb-8">
      <div class="flex flex-wrap items-center gap-3 text-xs text-dim">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.tags.map((tag) => (
          <span class="rounded border border-line px-1.5 py-0.5 text-[10px] text-muted">#{tag}</span>
        ))}
      </div>
      <h1 class="mt-4 font-display text-2xl font-bold leading-snug text-white sm:text-3xl">
        {post.data.title}
      </h1>
      <p class="mt-3 text-sm text-muted">{post.data.description}</p>
    </header>

    <div class="prose-term mt-8 text-sm sm:text-base">
      <Content />
    </div>

    <footer class="mt-16 rounded-lg border border-dashed border-line-bright p-5 text-xs text-muted">
      <span class="text-phosphor">$</span> {t('blog.eof')}
      <a href={localePath(lang, '/blog')} class="text-phosphor hover:underline">~/blog</a>
    </footer>
  </article>
</Base>

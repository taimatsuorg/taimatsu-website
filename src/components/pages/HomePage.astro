---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../ProjectCard.astro';
import Logo from '../Logo.astro';
import { Badge } from '../ui/badge';
import { buttonVariants } from '../ui/button';
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '../ui/card';
import { WindowFrame, WindowFrameBar, WindowFrameBody, WindowFrameTitle } from '../ui/window-frame';
import { ArrowRightIcon } from '../icons';
import { cn } from '../../lib/utils';
import { projects } from '../../data/projects';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const whyItems = [
  { title: t('home.why.1.title'), desc: t('home.why.1.desc') },
  { title: t('home.why.2.title'), desc: t('home.why.2.desc') },
  { title: t('home.why.3.title'), desc: t('home.why.3.desc') },
];

const terminalLines = [
  { t: 'cmd', text: 'ls -la ~/projects' },
  { t: 'out', text: 'drwxr-xr-x  novon.im           ', suffix: '[SOON]', suffixCls: 'text-warning' },
  { t: 'out', text: 'drwxr-xr-x  serverless.im      ', suffix: '[SOON]', suffixCls: 'text-warning' },
  { t: 'out', text: 'drwxr-xr-x  infrastructure.im  ', suffix: '[SOON]', suffixCls: 'text-warning' },
  { t: 'out', text: 'drwxr-xr-x  containers.im      ', suffix: '[SOON]', suffixCls: 'text-warning' },
  { t: 'cmd', text: './deploy --everything --now' },
  { t: 'out', text: '✓ zero config   ✓ zero yaml   ✓ zero regrets', cls: 'text-success' },
  { t: 'cmd', text: 'novon publish ./hello.md' },
  { t: 'out', text: '{"status":"coming_soon","eta":"stay_tuned"}', cls: 'text-warning' },
];
---

<Base
  title="taimatsu"
  lang={lang}
  description={lang === 'zh'
    ? 'taimatsu — 开发者基础设施工作室：Serverless API 聚合、多云一键部署、容器管理与博客托管服务。'
    : 'taimatsu — a developer infrastructure studio: serverless API hub, one-click multi-cloud deployment, container management and blog hosting.'}
>
  <section class="relative overflow-hidden">
    <div class="hero-grid pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-5xl px-4 pb-16 pt-20 sm:px-6 sm:pt-28">
      <Logo size={64} class="text-foreground" />
      <Badge variant="primary" className="mt-8">{t('home.badge')}</Badge>
      <h1 class="mt-5 font-heading text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
        build<span class="text-primary">.</span> deploy<span class="text-primary">.</span> ship<span class="text-primary">.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-pretty text-muted-foreground">
        {t('home.intro')}
      </p>
      <div class="mt-8 flex flex-wrap gap-2">
        <a href="#projects" class={buttonVariants({ size: 'lg' })}>
          {t('home.cta.projects')}
          <ArrowRightIcon size={16} className="rtl:-scale-x-100" />
        </a>
        <a href={lang === 'zh' ? '/zh/blog' : '/blog'} class={buttonVariants({ variant: 'outline', size: 'lg' })}>
          {t('home.cta.blog')}
        </a>
      </div>

      <WindowFrame className="mt-14 shadow-raised">
        <WindowFrameBar>
          <WindowFrameTitle align="center">{t('home.terminal.dir')}</WindowFrameTitle>
        </WindowFrameBar>
        <WindowFrameBody className="bg-background">
          <div id="term-body" class="min-h-72 space-y-1.5 px-4 py-5 font-mono text-ui-sm leading-6 whitespace-pre-wrap sm:text-ui">
            <div><span class="text-primary">$ </span><span>ls -la ~/projects</span></div>
            {terminalLines.slice(1, 5).map((line) => (
              <div class="text-muted-foreground">{line.text}<span class={line.suffixCls}>{line.suffix}</span></div>
            ))}
            <div><span class="text-primary">$ </span><span class="caret text-primary">▊</span></div>
          </div>
        </WindowFrameBody>
      </WindowFrame>
      <script is:inline define:vars={{ terminalLines }}>
          {
            const body = document.getElementById('term-body');
            const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

            const cursorEl = () => {
              const c = document.createElement('span');
              c.className = 'caret text-primary';
              c.textContent = '▊';
              return c;
            };

            const promptRow = () => {
              const r = document.createElement('div');
              const p = document.createElement('span');
              p.className = 'text-primary';
              p.textContent = '$ ';
              r.appendChild(p);
              return r;
            };

            const appendOut = (line) => {
              const r = document.createElement('div');
              r.className = line.cls || 'text-muted-foreground';
              r.textContent = line.text;
              if (line.suffix) {
                const s = document.createElement('span');
                s.className = line.suffixCls || '';
                s.textContent = line.suffix;
                r.appendChild(s);
              }
              body.appendChild(r);
            };

            const typeCmd = async (text) => {
              const r = promptRow();
              const typed = document.createElement('span');
              typed.className = 'text-foreground';
              const cur = cursorEl();
              r.appendChild(typed);
              r.appendChild(cur);
              body.appendChild(r);
              for (const ch of text) {
                typed.textContent += ch;
                await sleep(35 + Math.random() * 55);
              }
              cur.remove();
              await sleep(400);
            };

            (async () => {
              for (;;) {
                body.innerHTML = '';
                for (const line of terminalLines) {
                  if (line.t === 'cmd') {
                    await typeCmd(line.text);
                  } else {
                    appendOut(line);
                    await sleep(150);
                  }
                }
                const idle = promptRow();
                idle.appendChild(cursorEl());
                body.appendChild(idle);
                await sleep(7000);
              }
            })();
          }
        </script>
    </div>
  </section>

  <section id="projects" class="scroll-mt-14 border-t border-border bg-muted/40">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-heading text-2xl font-semibold tracking-tight sm:text-3xl">{t('home.projects.title')}</h2>
        <span class="text-ui text-muted-foreground">{t('home.projects.count')}</span>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="font-heading text-2xl font-semibold tracking-tight sm:text-3xl">{t('home.why.title')}</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-3">
        {whyItems.map((item, i) => (
          <Card variant="outline">
            <CardHeader>
              <span class="font-mono text-ui-sm text-muted-foreground">{String(i + 1).padStart(2, '0')}</span>
              <CardTitle>{item.title}</CardTitle>
              <CardDescription>{item.desc}</CardDescription>
            </CardHeader>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
      <Card variant="inset">
        <div data-slot="card-panel" class="flex flex-col gap-6 rounded-inner bg-card p-6 shadow-raised sm:p-10">
          <span class="text-ui-sm font-medium text-muted-foreground">{t('home.manifesto.label')}</span>
          <p class="max-w-3xl text-lg leading-relaxed text-pretty">
            {t('home.manifesto.p1')}<span class="font-medium text-primary">{t('home.manifesto.cmd1')}</span>{t('home.manifesto.p2')}<span class="font-medium text-primary">{t('home.manifesto.cmd2')}</span>{t('home.manifesto.p3')}<span class="font-medium text-primary">{t('home.manifesto.cmd3')}</span>{t('home.manifesto.p4')}
          </p>
          <figure class="flex items-center gap-3 border-t border-border pt-6">
            <Logo size={28} class="shrink-0 text-foreground" />
            <blockquote class="font-serif text-lg italic">“{t('home.quote')}”</blockquote>
            <figcaption class="ms-auto shrink-0 text-ui text-muted-foreground">— {t('home.quote.by')}</figcaption>
          </figure>
        </div>
      </Card>
    </div>
  </section>
</Base>

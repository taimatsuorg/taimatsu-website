---
import type { Project } from '../data/projects';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  project: Project;
  index: number;
  lang: Lang;
}

const { project, index, lang } = Astro.props;
const t = useTranslations(lang);
const live = project.status === 'live';
---

<div class="card-hover group relative flex flex-col rounded-lg border border-line bg-panel p-5">
  <div class="flex items-start justify-between gap-3">
    <div>
      <div class="text-xs text-dim">[{String(index).padStart(2, '0')}]</div>
      <h3 class="mt-1 font-display text-lg font-bold text-white">
        {project.domain}
      </h3>
    </div>
    {
      live ? (
        <span class="flex items-center gap-1.5 rounded-full border border-phosphor/40 bg-phosphor/10 px-2.5 py-0.5 text-[10px] font-bold tracking-widest text-phosphor">
          <span class="pulse-dot inline-block h-1.5 w-1.5 rounded-full bg-phosphor" />
          {t('project.live')}
        </span>
      ) : (
        <span class="flex items-center gap-1.5 rounded-full border border-amberish/40 bg-amberish/10 px-2.5 py-0.5 text-[10px] font-bold tracking-widest text-amberish">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-amberish" />
          {t('project.soon')}
        </span>
      )
    }
  </div>

  <p class="mt-3 text-sm text-phosphor-dim">{project.tagline[lang]}</p>
  <p class="mt-2 text-sm leading-7 text-muted">{project.description[lang]}</p>

  <ul class="mt-4 flex-1 space-y-1.5 text-xs leading-6 text-muted">
    {project.features[lang].map((feature) => (
      <li class="flex gap-2">
        <span class="text-phosphor">✓</span>
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  <div class="mt-4 rounded border border-line bg-void px-3 py-2 text-xs text-dim">
    <span class="text-phosphor">$</span> {project.cmd}
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-1.5">
    {project.tags.map((tag) => (
      <span class="rounded border border-line px-1.5 py-0.5 text-[10px] text-muted">#{tag}</span>
    ))}
  </div>

  <a
    href={live ? project.url : undefined}
    target={live ? '_blank' : undefined}
    rel="noopener noreferrer"
    aria-disabled={!live}
    class:list={[
      'mt-5 inline-flex items-center justify-center gap-2 rounded border px-3 py-2 text-xs font-bold transition-colors',
      live
        ? 'border-phosphor/50 text-phosphor hover:bg-phosphor hover:text-black'
        : 'cursor-not-allowed border-line text-dim',
    ]}
  >
    {live ? `${t('project.visit')} ${project.domain} →` : t('project.stayTuned')}
  </a>
</div>

---
import { Card, CardAction, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from './ui/card';
import { Badge } from './ui/badge';
import { buttonVariants } from './ui/button';
import { CheckIcon, ArrowUpRightIcon } from './icons';
import { SiteCommand } from './site/Islands';
import { cn } from '../lib/utils';
import type { Project } from '../data/projects';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const live = project.status === 'live';
---

<Card className="h-full">
  <CardHeader>
    <CardTitle className="text-lg">{project.domain}</CardTitle>
    <CardDescription className="text-primary">{project.tagline[lang]}</CardDescription>
    <CardAction>
      <Badge variant={live ? 'success' : 'warning'} size="sm">
        {live ? t('project.live') : t('project.soon')}
      </Badge>
    </CardAction>
  </CardHeader>
  <CardContent className="flex flex-1 flex-col gap-4">
    <p class="text-ui leading-relaxed text-muted-foreground">{project.description[lang]}</p>
    <ul class="space-y-2">
      {project.features[lang].map((feature) => (
        <li class="flex gap-2 text-ui">
          <CheckIcon size={16} className="mt-px shrink-0 text-primary" />
          <span>{feature}</span>
        </li>
      ))}
    </ul>
    <div class="mt-auto flex flex-wrap gap-1.5">
      {project.tags.map((tag) => <Badge variant="outline" size="sm">{tag}</Badge>)}
    </div>
    <SiteCommand lang={lang} command={project.cmd} client:visible />
  </CardContent>
  <CardFooter>
    {
      live ? (
        <a href={project.url} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: 'secondary' }), 'w-full')}>
          {t('project.visit')} {project.domain}
          <ArrowUpRightIcon size={16} />
        </a>
      ) : (
        <span aria-disabled="true" class={cn(buttonVariants({ variant: 'secondary' }), 'pointer-events-none w-full opacity-64')}>
          {t('project.stayTuned')}
        </span>
      )
    }
  </CardFooter>
</Card>

---
import { alternateLocalePath, localePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;

const links = [
  { href: localePath(lang, '/'), label: t('nav.home') },
  { href: `${localePath(lang, '/') === '/' ? '' : `/${lang}`}/#projects`, label: t('nav.projects') },
  { href: localePath(lang, '/blog'), label: t('nav.blog') },
];

function isActive(href: string) {
  const home = localePath(lang, '/');
  if (href === home) return path === home || path === `${home}/`;
  if (href.includes('#')) return false;
  return path.startsWith(href);
}

const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const switchHref = alternateLocalePath(path, otherLang);
---

<header class="sticky top-0 z-50 border-b border-line bg-void/85 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6">
    <a href={localePath(lang, '/')} class="group flex items-center gap-2 text-sm font-bold text-white">
      <span class="text-phosphor glow">▲</span>
      <span>taimatsu<span class="blink text-phosphor">_</span></span>
    </a>

    <div class="flex items-center gap-1 text-xs sm:gap-2 sm:text-sm">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded px-2 py-1 transition-colors hover:text-phosphor',
              isActive(link.href) ? 'text-phosphor' : 'text-muted',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={switchHref}
        hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'}
        class="ml-1 rounded border border-line px-2 py-1 text-muted transition-colors hover:border-phosphor/50 hover:text-phosphor"
        title={otherLang === 'zh' ? '切换到中文' : 'Switch to English'}
      >
        {otherLang === 'zh' ? '中' : 'EN'}
      </a>
      <a
        href="https://github.com"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1.5 rounded border border-line px-2.5 py-1 text-muted transition-colors hover:border-phosphor/50 hover:text-phosphor sm:flex"
      >
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
        </svg>
        github
      </a>
    </div>
  </nav>
</header>

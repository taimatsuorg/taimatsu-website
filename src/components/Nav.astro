---
import Logo from './Logo.astro';
import { buttonVariants } from './ui/button';
import { GithubIcon } from './icons';
import { SiteThemeToggle } from './site/Islands';
import { cn } from '../lib/utils';
import { alternateLocalePath, localePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;

const links = [
  { href: `${localePath(lang, '/') === '/' ? '' : `/${lang}`}/#projects`, label: t('nav.projects') },
  { href: localePath(lang, '/blog'), label: t('nav.blog') },
];

function isActive(href: string) {
  if (href.includes('#')) return false;
  return path.startsWith(href);
}

const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const switchHref = alternateLocalePath(path, otherLang);
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-xl">
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={localePath(lang, '/')} class="flex items-center gap-2 text-ui-lg font-semibold text-foreground">
      <Logo size={22} />
      <span>taimatsu</span>
    </a>

    <div class="flex items-center gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class={cn(
              buttonVariants({ variant: 'ghost', size: 'sm' }),
              isActive(link.href) ? 'bg-secondary' : 'text-muted-foreground'
            )}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={switchHref}
        hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'}
        onclick={`try{localStorage.setItem('lang','${otherLang}')}catch(e){}`}
        class={cn(buttonVariants({ variant: 'ghost', size: 'sm' }), 'text-muted-foreground')}
        title={otherLang === 'zh' ? '切换到中文' : 'Switch to English'}
      >
        {otherLang === 'zh' ? '中文' : 'EN'}
      </a>
      <a
        href="https://github.com/taimatsuorg"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class={buttonVariants({ variant: 'ghost', size: 'icon-sm' })}
      >
        <GithubIcon size={16} />
      </a>
      <SiteThemeToggle lang={lang} client:load />
    </div>
  </nav>
</header>

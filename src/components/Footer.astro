---
import { localePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-panel">
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <div class="text-sm font-bold text-white">
          <span class="text-phosphor">▲</span> taimatsu<span class="blink text-phosphor">_</span>
        </div>
        <p class="mt-3 text-xs leading-6 text-muted">
          {t('footer.tagline')}<br />{t('footer.motto')}
        </p>
      </div>

      <div>
        <div class="text-xs font-bold text-dim">{t('footer.sitemap')}</div>
        <ul class="mt-3 space-y-2 text-xs">
          <li><a href={localePath(lang, '/')} class="text-muted transition-colors hover:text-phosphor">{t('nav.home')}</a></li>
          <li><a href={`${localePath(lang, '/') === '/' ? '' : `/${lang}`}/#projects`} class="text-muted transition-colors hover:text-phosphor">{t('nav.projects')}</a></li>
          <li><a href={localePath(lang, '/blog')} class="text-muted transition-colors hover:text-phosphor">{t('nav.blog')}</a></li>
        </ul>
      </div>

      <div>
        <div class="text-xs font-bold text-dim">{t('footer.legal')}</div>
        <ul class="mt-3 space-y-2 text-xs">
          <li><a href={localePath(lang, '/privacy')} class="text-muted transition-colors hover:text-phosphor">{t('footer.privacy')}</a></li>
          <li><a href={localePath(lang, '/terms')} class="text-muted transition-colors hover:text-phosphor">{t('footer.terms')}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-line pt-6 text-xs text-dim sm:flex-row sm:items-center">
      <span>&copy; {year} {t('footer.rights')}</span>
      <span>
        <span class="text-phosphor">$</span> echo "{t('footer.made')}"
      </span>
    </div>
  </div>
</footer>

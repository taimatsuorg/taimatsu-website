---
import Logo from './Logo.astro';
import { localePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const link = 'text-ui text-muted-foreground transition-colors hover:text-foreground';
---

<footer class="border-t border-border bg-muted/40">
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-[2fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2 text-ui-lg font-semibold">
          <Logo size={20} /> taimatsu
        </div>
        <p class="mt-3 max-w-xs text-ui leading-relaxed text-muted-foreground">
          {t('footer.tagline')}
        </p>
      </div>

      <div>
        <div class="text-ui-sm font-medium text-muted-foreground">{t('footer.sitemap')}</div>
        <ul class="mt-3 space-y-2">
          <li><a href={localePath(lang, '/')} class={link}>{t('nav.home')}</a></li>
          <li><a href={`${localePath(lang, '/') === '/' ? '' : `/${lang}`}/#projects`} class={link}>{t('nav.projects')}</a></li>
          <li><a href={localePath(lang, '/blog')} class={link}>{t('nav.blog')}</a></li>
        </ul>
      </div>

      <div>
        <div class="text-ui-sm font-medium text-muted-foreground">{t('footer.legal')}</div>
        <ul class="mt-3 space-y-2">
          <li><a href={localePath(lang, '/privacy')} class={link}>{t('footer.privacy')}</a></li>
          <li><a href={localePath(lang, '/terms')} class={link}>{t('footer.terms')}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col justify-between gap-2 border-t border-border pt-6 text-ui-sm text-muted-foreground sm:flex-row">
      <span>&copy; {year} {t('footer.rights')}</span>
      <span>{t('footer.motto')}</span>
    </div>
  </div>
</footer>

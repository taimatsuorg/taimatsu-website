---
import Logo from '../../components/Logo.astro';
import { buttonVariants } from '../../components/ui/button';
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('zh');
---

<Base title="404" lang="zh">
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-32 text-center sm:px-6">
    <Logo size={72} class="text-foreground" />
    <h1 class="mt-8 font-heading text-6xl font-semibold tracking-tight">404</h1>
    <p class="mt-4 text-base text-muted-foreground">{t('404.title')}</p>
    <p class="mt-2 font-mono text-ui-sm text-muted-foreground">{Astro.url.pathname}</p>
    <a href="/zh" class={buttonVariants({ className: 'mt-8' })}>{t('404.home')}</a>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('zh');
---

<Base title="404" lang="zh">
  <section class="relative overflow-hidden">
    <div class="grid-bg absolute inset-0"></div>
    <div class="relative mx-auto flex max-w-3xl flex-col items-center px-4 py-32 text-center sm:px-6">
      <div class="rounded-lg border border-line bg-panel px-6 py-5 text-left text-sm">
        <div><span class="text-phosphor">$</span> cd {Astro.url.pathname}</div>
        <div class="mt-2 text-danger">bash: cd: {Astro.url.pathname}: No such file or directory</div>
      </div>
      <h1 class="mt-10 font-display text-6xl font-bold text-white">
        4<span class="text-phosphor glow">0</span>4
      </h1>
      <p class="mt-4 text-sm text-muted">{t('404.title')} <span class="text-phosphor">rm -rf</span> {''}了。</p>
      <a
        href="/"
        class="mt-8 rounded border border-phosphor/50 px-4 py-2 text-xs font-bold text-phosphor transition-colors hover:bg-phosphor hover:text-black"
      >
        {t('404.home')}
      </a>
    </div>
  </section>
</Base>

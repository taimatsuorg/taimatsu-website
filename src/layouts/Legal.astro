---
import Base from './Base.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    updated?: string;
  };
}

const { title, description, updated } = Astro.props.frontmatter;
const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang);
---

<Base title={title} description={description} lang={lang}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <header class="border-b border-border pb-8">
      <h1 class="font-heading text-3xl font-semibold tracking-tight">{title}</h1>
      {updated && <p class="mt-3 text-ui text-muted-foreground">{t('legal.updated')}{updated}</p>}
    </header>
    <div class="typeset typeset-docs mt-8">
      <slot />
    </div>
  </article>
</Base>

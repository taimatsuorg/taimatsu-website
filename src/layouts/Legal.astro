---
import Base from './Base.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    updated?: string;
  };
}

const { title, description, updated } = Astro.props.frontmatter;
const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang);
---

<Base title={title} description={description} lang={lang}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <header class="border-b border-line pb-8">
      <div class="text-xs text-muted"><span class="text-phosphor">~</span>/legal</div>
      <h1 class="mt-3 font-display text-2xl font-bold text-white sm:text-3xl">
        <span class="text-phosphor">#</span> {title}
      </h1>
      {updated && <p class="mt-3 text-xs text-dim">{t('legal.updated')}{updated}</p>}
    </header>
    <div class="prose-term mt-8 text-sm leading-7">
      <slot />
    </div>
  </article>
</Base>
